// Active local desktop users may control only C5 ttyACM receiver instances.
// The unprivileged session separately enforces the root-owned serial allowlist.
polkit.addRule(function(action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units" ||
        !subject.local || !subject.active) {
        return polkit.Result.NOT_HANDLED;
    }
    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    if (typeof unit === "string" && /^esp32c5-airdrop@ttyACM[0-9]+\.service$/.test(unit) &&
        ["start", "stop", "restart"].indexOf(verb) >= 0) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
