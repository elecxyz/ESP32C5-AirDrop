--- a/opendrop/config.py
+++ b/opendrop/config.py
@@ -81,7 +81,31 @@ class AirDropConfig:
         self.port = server_port
 
         if service_id is None:
-            service_id = f"{random.randint(0, 0xFFFFFFFFFFFF):012x}"  # random 6-byte string in base16
+            # A receiver is one Bonjour service, not a new device on every
+            # invocation.  A random ID per process leaves stale 75-minute PTR
+            # records on iOS whenever the radio vanishes before a goodbye can
+            # be sent, eventually producing several identities for one host.
+            # Persist the 48-bit identifier alongside the receiver keys.
+            os.makedirs(self.airdrop_dir, exist_ok=True)
+            service_id_file = os.path.join(self.airdrop_dir, "service_id")
+            try:
+                with open(service_id_file, "r", encoding="ascii") as f:
+                    saved_service_id = f.read().strip().lower()
+            except OSError:
+                saved_service_id = ""
+            if len(saved_service_id) == 12 and all(
+                c in "0123456789abcdef" for c in saved_service_id
+            ):
+                service_id = saved_service_id
+            else:
+                service_id = f"{random.randint(0, 0xFFFFFFFFFFFF):012x}"
+                tmp = service_id_file + ".tmp"
+                with open(tmp, "w", encoding="ascii") as f:
+                    f.write(service_id + "\n")
+                    f.flush()
+                    os.fsync(f.fileno())
+                os.chmod(tmp, 0o600)
+                os.replace(tmp, service_id_file)
         self.service_id = service_id
 
         self.debug = debug
